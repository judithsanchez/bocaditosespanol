sequenceDiagram
    participant Caller
    participant SES as SensesEnrichmentStep
    participant Ctx as ContentProcessingContext
    participant Logger
    participant SchemaFactory as TokenAIEnrichmentFactory
    participant InstructionFactory as TokenAIEnrichmentInstructionFactory
    participant BP as BatchProcessor
    participant Enricher as GenericAIEnricher

    Caller->>+SES: process(context)
    SES->>Logger: start('process')
    SES->>Ctx: Read context.tokens.deduplicated
    Ctx-->>SES: deduplicatedTokens
    SES->>SES: Filter IWord tokens from deduplicatedTokens
    SES->>Logger: info('Starting senses enrichment', {count})
    SES->>+BP: process({ items: wordTokens, processingFn, onProgress })
    loop For each batch of words
        BP->>+SES: processingFn(batchItems)
        SES->>+SchemaFactory: createSenseSchema()
        SchemaFactory-->>-SES: schema
        SES->>+InstructionFactory: createSensesInstruction()
        InstructionFactory-->>-SES: instruction
        SES->>+Enricher: enrich({ input: batchItems, schema, instruction })
        Enricher-->>-SES: enrichedBatchWithSenses (IWord[])
        SES-->>-BP: enrichedBatchWithSenses
        BP->>SES: onProgress(progress)
        SES->>Logger: info('Senses enrichment progress', {progress})
    end
    BP-->>-SES: allEnrichedWords (IWord[])
    SES->>SES: Map enriched words to update original tokens (add senses, generate senseId)
    SES->>SES: Merge enriched words with original non-word tokens
    SES->>Ctx: Update context.tokens.enriched
    SES->>Logger: info('Senses enrichment completed', {count})
    SES->>Logger: end('process')
    SES-->>-Caller: updatedContext
