%%{init: {'theme': 'dark', 'themeVariables': { 'background': '#1e1e1e', 'primaryColor': '#2d2d30', 'primaryBorderColor': '#3c3c3c', 'primaryTextColor': '#d4d4d4', 'lineColor': '#569cd6', 'secondaryColor': '#ce9178', 'tertiaryColor': '#4ec9b0'}}}%%
sequenceDiagram
    participant Client
    participant WriteSvc as WriteDatabaseService
    participant ReadSvc as ReadDatabaseService
    participant FS as File System (fs/promises)
    participant Config as DatabaseConfig

    Client->>+WriteSvc: new WriteDatabaseService()
    WriteSvc->>Config: Read paths.data
    WriteSvc->>+FS: existsSync(dataPath)
    FS-->>-WriteSvc: boolean (exists)
    alt Directory does not exist
        WriteSvc->>+FS: mkdir(dataPath, {recursive: true})
        FS-->>-WriteSvc: (void)
    end
    WriteSvc->>+ReadSvc: new ReadDatabaseService()
    ReadSvc-->>-WriteSvc: instance
    WriteSvc-->>-Client: instance

    Client->>+WriteSvc: saveTokens(tokens)
    WriteSvc->>Config: Read files.tokens
    WriteSvc->>+ReadSvc: readFile(tokensFilename)
    ReadSvc-->>-WriteSvc: currentTokensData | null
    alt Valid data received
        WriteSvc->>WriteSvc: Assign currentTokensData to this.tokens
    else Invalid or null data
        WriteSvc->>WriteSvc: Initialize this.tokens with empty structure
    end
    loop for each token in tokens
        WriteSvc->>WriteSvc: addToken(token)
        alt Token is Word
            WriteSvc->>WriteSvc: this.tokens.words[tokenId] = token
        else Token is Punctuation
            WriteSvc->>WriteSvc: this.tokens.punctuationSigns[tokenId] = token
        else Token is Emoji
            WriteSvc->>WriteSvc: this.tokens.emojis[tokenId] = token
        end
    end
    WriteSvc->>Config: Read files.tokens
    WriteSvc->>WriteSvc: writeFile(tokensFilename, this.tokens)
    WriteSvc->>Config: Read paths.data
    WriteSvc->>+FS: writeFile(filePath, jsonData)
    FS-->>-WriteSvc: (void)
    WriteSvc-->>-Client: Promise<void>
