# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.env
.vscode

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Vercel specific (Vercel handles its own build artifacts and environment)
/.vercel

# Environment variables
# Ensure these are never committed! Manage them in Vercel's dashboard.
.env
.env*.local
.env.development
.env.production
# Exclude all .env files unless specifically un-ignored
# !.env.example # You might want to commit an example env file

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Other
coverage
*.lcov
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history

# Optional eslint cache
.eslintcache

# TypeScript cache
*.tsbuildinfo

# macOS
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.TemporaryItems
.Trashes
.com.apple.timemachine.donotpresent
*.icloud

# Windows
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# If you are using Turborepo
.turbo